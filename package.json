{
  "name": "hermes-field-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:enhancements": "node tests/enhancements.mjs",
    "test:markings": "node tests/markings-browser.mjs",
    "test:rules": "firebase emulators:exec --project demo-hermes --only firestore \"node tests/firestore-rules.mjs\"",
    "test:social": "node tests/social-browser.mjs",
    "test:flight": "node tests/flight-search-browser.mjs",
    "test:maps": "node tests/map-files-browser.mjs",
    "test:basemap": "node tests/basemap-browser.mjs",
    "test:startup": "node tests/startup-browser.mjs",
    "test:map-lifecycle": "node tests/map-lifecycle-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "firebase-tools": "^15.27.0"
  }
}
